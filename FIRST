<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SBV3-MLB</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#000;
overflow:hidden;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
color:#fff;
position:relative;
}

canvas{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
z-index:0;
pointer-events:none;
}

.box{
position:relative;
z-index:10;
width:420px;
max-width:90%;
padding:45px;
text-align:center;
border-radius:18px;
background:rgba(0,0,0,.75);
overflow:hidden;
}

.box::before{
content:"";
position:absolute;
top:50%;
left:50%;
width:220%;
height:220%;
background:conic-gradient(
transparent,
transparent,
#00bfff,
#66e0ff,
#00bfff,
transparent
);
transform:translate(-50%,-50%);
animation:borderRotate 5s linear infinite;
filter:blur(6px);
z-index:-2;
}

.box::after{
content:"";
position:absolute;
inset:3px;
background:#000;
border-radius:16px;
z-index:-1;
}

@keyframes borderRotate{
100%{
transform:translate(-50%,-50%) rotate(360deg);
}
}

.profile{
width:120px;
height:120px;
border-radius:50%;
object-fit:cover;
border:3px solid #00bfff;
margin-bottom:20px;
box-shadow:
0 0 15px #00bfff,
0 0 30px #00bfff,
0 0 60px #00bfff;
animation:profileGlow 2s infinite alternate;
}

@keyframes profileGlow{
from{
box-shadow:
0 0 15px #00bfff,
0 0 30px #00bfff;
}
to{
box-shadow:
0 0 25px #00bfff,
0 0 50px #00bfff,
0 0 80px #00bfff;
}
}
h1{
font-size:56px;
color:#fff;
text-shadow:
0 0 8px #fff,
0 0 18px #fff,
0 0 35px #00bfff;
margin-bottom:15px;
}

p{
font-size:22px;
margin-bottom:35px;
text-shadow:0 0 10px #fff;
}

a{
position:relative;
display:inline-block;
padding:18px 50px;
font-size:24px;
font-weight:bold;
color:#fff;
text-decoration:none;
border:2px solid #00bfff;
border-radius:12px;
overflow:hidden;
box-shadow:
0 0 15px #00bfff,
0 0 30px #00bfff,
0 0 60px #00bfff;
transition:.3s;
}

a::before{
content:"";
position:absolute;
top:0;
left:-120%;
width:60%;
height:100%;
background:linear-gradient(
90deg,
transparent,
rgba(255,255,255,.9),
transparent
);
transform:skewX(-25deg);
animation:shine 2s linear infinite;
}

@keyframes shine{
0%{left:-120%;}
100%{left:150%;}
}

a:hover{
background:#00bfff;
color:#000;
transform:scale(1.08);
box-shadow:
0 0 25px #00bfff,
0 0 60px #00bfff,
0 0 100px #00bfff;
}

</style>

</head>

<body>

<canvas id="snow"></canvas>

<div class="box">

<img src="profile.png" class="profile">

<h1>SBV3-MLB</h1>

<p>ยินดีต้อนรับเข้าสู่เซิร์ฟเวอร์ SBV3 MLB</p>

<a href="https://discord.gg/ใส่ลิงก์ของคุณ" target="_blank">
JOIN SERVER
</a>

</div>

<script>

const canvas=document.getElementById("snow");
const ctx=canvas.getContext("2d");

function resize(){

canvas.width=window.innerWidth;
canvas.height=window.innerHeight;

}

resize();
window.onresize=resize;

const snow=[];
for(let i=0;i<180;i++){

snow.push({

x:Math.random()*canvas.width,
y:Math.random()*canvas.height,
r:Math.random()*3+1,
d:Math.random()*1.5+0.5

});

}

function draw(){

ctx.clearRect(0,0,canvas.width,canvas.height);

ctx.fillStyle="white";

for(let i=0;i<snow.length;i++){

const s=snow[i];

ctx.beginPath();
ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
ctx.fill();

s.y+=s.d;
s.x+=Math.sin(s.y*0.01);

if(s.y>canvas.height){

s.y=-5;
s.x=Math.random()*canvas.width;

}

}

requestAnimationFrame(draw);

}

draw();
</script>

</body>
</html>
